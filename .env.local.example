# Supabase (new key system — use sb_publishable_xxx key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxx

# Telegram Bot (create at https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-personal-chat-id

# Google Gemini (free at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-key

# NewsAPI (free at https://newsapi.org)
NEWS_API_KEY=your-newsapi-key

# Alpha Vantage (free at https://www.alphavantage.co — 25 req/day)
ALPHA_VANTAGE_KEY=your-alpha-vantage-key

# Vercel Cron auth secret (any random string)
CRON_SECRET=your-random-secret-string
